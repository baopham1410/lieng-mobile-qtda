APP_NAME="Lieng Mobile"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Neon PostgreSQL â€” dÃ¡n connection string tá»« https://console.neon.tech
DB_CONNECTION=pgsql
DB_HOST=ep-xxx-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require
DB_ENDPOINT_ID=ep-xxx

# Hoáº·c Ä‘iá»n tá»«ng field (náº¿u khÃ´ng dÃ¹ng DATABASE_URL):
# DB_HOST=ep-xxxxx.region.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=your_user
# DB_PASSWORD=your_password
# DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=
PAYOS_RETURN_URL=http://localhost:5173/pos
PAYOS_CANCEL_URL=http://localhost:5173/pos

# RAG chatbot (assistant-service FastAPI)
ASSISTANT_SERVICE_URL=http://127.0.0.1:8090
ASSISTANT_TIMEOUT=120
